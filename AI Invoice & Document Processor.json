    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const body = item.json.body ?? {};\n  const headers = item.json.headers ?? {};\n\n  let fileData = body.file_base64 ?? null;\n  let fileName = body.file_name ?? 'document';\n  let mimeType = body.mime_type ?? '';\n\n  const binaryKey = Object.keys(item.binary ?? {})[0];\n\n  if (binaryKey) {\n    const binary = item.binary[binaryKey];\n    const buffer = await this.helpers.getBinaryDataBuffer(i, binaryKey);\n\n    fileData = buffer.toString('base64');\n    fileName = binary.fileName || fileName;\n    mimeType = binary.mimeType || mimeType;\n  }\n\n  if (!fileData) {\n    throw new Error('No document found in the input.');\n  }\n\n  if (!mimeType || mimeType === 'application/json') {\n    const ext = fileName.split('.').pop().toLowerCase();\n\n    mimeType = {\n      png: 'image/png',\n      jpg: 'image/jpeg',\n      jpeg: 'image/jpeg',\n      webp: 'image/webp'\n    }[ext] || 'application/octet-stream';\n  }\n\n  results.push({\n    json: {\n      fileData,\n      fileName,\n      mimeType,\n      source: 'webhook-upload',\n      receivedAt: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "0155f46f-c412-4701-912f-79470d3ef531",
      "name": "Extract File Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -992,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json.output?.[0]?.content?.[0]?.text;\n\nif (!aiResponse || typeof aiResponse !== 'object') {\n  throw new Error('AI did not return a structured invoice object.');\n}\n\nconst fileInfo = $('Extract File Data').first().json;\n\nconst isInvoice =\n  String(aiResponse.document_type ?? '').trim().toLowerCase() === 'invoice';\n\nconst hasVendor = Boolean(aiResponse.vendor?.name?.trim());\nconst hasInvoiceNumber = Boolean(aiResponse.invoice_number?.trim());\nconst hasDate = Boolean(aiResponse.invoice_date?.trim());\n\nconst hasTotal =\n  typeof aiResponse.total === 'number' &&\n  Number.isFinite(aiResponse.total);\n\nconst lineItems = aiResponse.line_items;\n\nconst hasLineItems =\n  Array.isArray(lineItems) &&\n  lineItems.length > 0 &&\n  lineItems.every(item =>\n    typeof item.description === 'string' &&\n    item.description.trim() !== '' &&\n    Number.isFinite(item.quantity) &&\n    item.quantity > 0 &&\n    Number.isFinite(item.unit_price) &&\n    item.unit_price >= 0 &&\n    Number.isFinite(item.total) &&\n    item.total >= 0\n  );\n\nconst lineItemsConsistent =\n  hasLineItems &&\n  lineItems.every(item =>\n    Math.abs(item.quantity * item.unit_price - item.total) <= 0.05\n  );\n\nconst hasFinancialValues = [\n  aiResponse.subtotal,\n  aiResponse.tax_amount,\n  aiResponse.discount,\n  aiResponse.total\n].every(Number.isFinite);\n\nconst expectedTotal =\n  aiResponse.subtotal +\n  aiResponse.tax_amount -\n  aiResponse.discount;\n\nconst totalsConsistent =\n  hasFinancialValues &&\n  Math.abs(expectedTotal - aiResponse.total) <=\n    Math.max(0.05, Math.abs(aiResponse.total) * 0.01);\n\nconst validation = {\n  isInvoice,\n  hasVendor,\n  hasInvoiceNumber,\n  hasDate,\n  hasTotal,\n  hasLineItems,\n  lineItemsConsistent,\n  totalsConsistent\n};\n\nconst validFieldCount = [\n  hasVendor,\n  hasInvoiceNumber,\n  hasDate,\n  hasTotal,\n  hasLineItems\n].filter(Boolean).length;\n\nconst needsReview = !(\n  isInvoice &&\n  validFieldCount === 5 &&\n  lineItemsConsistent &&\n  totalsConsistent\n);\n\nconst dataQuality = needsReview\n  ? validFieldCount >= 3 ? 'medium' : 'low'\n  : 'high';\n\nreturn [{\n  json: {\n    ...aiResponse,\n    _metadata: {\n      fileName: fileInfo.fileName,\n      source: fileInfo.source,\n      processedAt: new Date().toISOString(),\n      dataQuality,\n      needsReview,\n      validation\n    }\n  }\n}];"
      },
